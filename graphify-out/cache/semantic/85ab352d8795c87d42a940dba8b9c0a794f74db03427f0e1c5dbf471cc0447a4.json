{"nodes": [{"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_phase_3_wireguard_tunnel_and_hybrid_dns_implementation_plan", "label": "Phase 3 WireGuard Tunnel and Hybrid DNS Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "# Phase 3 \u2014 WireGuard Tunnel + Hybrid DNS Implementation Plan", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_split_tunnel_wireguard_link", "label": "Split-Tunnel WireGuard Link", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "## Goal", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_bidirectional_conditional_dns_forwarding", "label": "Bidirectional Conditional DNS Forwarding", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "## Goal", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_native_debian_docker_engine", "label": "Native Debian Docker Engine", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### 1.2 Restore and prove the Phase 1 runtime", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The data-plane containers must share Debian's routing and iptables namespace so their DNS traffic traverses wg0; Docker Desktop does not."}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_exact_address_spatium_dns_listener", "label": "Exact-Address Spatium DNS Listener", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### 1.2 Restore and prove the Phase 1 runtime", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binding only 172.16.0.2:53 over UDP and TCP avoids exposing the recursive resolver on unrelated host interfaces."}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_fresh_kea_lease_dns_proof", "label": "Fresh Kea Lease DNS Proof", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### 1.3 Rehearse the fresh Kea lease proof", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_hub_first_conditional_vm_sequence", "label": "Hub-First Conditional VM Sequence", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### Hard safety and cost contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starting the app only after hub-only tunnel checks pass limits the paid window and prevents compounding failures."}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_independent_deallocation_watchdog", "label": "Independent Deallocation Watchdog", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### 1.5 Prepare and dry-run the independent VM watchdog", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate deallocation-only process protects the 60-minute cost boundary if the agent or tool session is interrupted."}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_state_aware_hub_key_installation", "label": "State-Aware Hub Key Installation", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### 2.2 Install or reuse the hub WireGuard key safely", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The key step creates once or verifies consistency, preventing a retry from silently rotating only one side of the tunnel."}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_mandatory_tunnel_and_vm_closeout", "label": "Mandatory Tunnel and VM Closeout", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### 2.6 Mandatory closeout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All success, failure, timeout, and interruption paths end with wg0 down and all three VMs verified deallocated."}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_phase_3_private_resolver_absence", "label": "Phase 3 Private Resolver Absence", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### Hard safety and cost contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The paid managed resolver is not required for the proven hub-BIND architecture and remains disabled."}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_retain_or_destroy_decision", "label": "Retain-or-Destroy Decision", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "## Task 4 \u2014 Checkpoint D: explicit retain-or-destroy decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_07_31_phase_3_wireguard_hybrid_dns_direct_hop_before_composed_dns_testing", "label": "Direct-Hop Before Composed DNS Testing", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-31-phase-3-wireguard-hybrid-dns.md", "source_location": "### 2.5 Conditionally start and prove the app path", "source_url": null, "captured_at": null, "author": null, "contributor": null