{"nodes": [{"id": "plans_2026_08_04_phase_3_wireguard_hybrid_dns_research_phase_3_wireguard_and_hybrid_dns_planning_research", "label": "Phase 3 WireGuard and Hybrid DNS Planning Research", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-04-phase-3-wireguard-hybrid-dns-research.md", "source_location": "# Phase 3 WireGuard + Hybrid DNS \u2014 Planning Research", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_08_04_phase_3_wireguard_hybrid_dns_research_docker_desktop_wireguard_namespace_mismatch", "label": "Docker Desktop WireGuard Namespace Mismatch", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-04-phase-3-wireguard-hybrid-dns-research.md", "source_location": "### BLOCKER 2 \u2014 Docker Desktop container traffic bypasses Debian wg0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docker Desktop exposes a CLI in Debian but keeps container sockets in its own VM and Windows backend path, bypassing Debian wg0."}, {"id": "plans_2026_08_04_phase_3_wireguard_hybrid_dns_research_native_debian_runtime_choice", "label": "Native Debian Runtime Choice", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-04-phase-3-wireguard-hybrid-dns-research.md", "source_location": "### BLOCKER 2 \u2014 Docker Desktop container traffic bypasses Debian wg0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping WSL2 as the endpoint requires the Spatium data plane to run under Debian dockerd with an exact-address DNS bind."}, {"id": "plans_2026_08_04_phase_3_wireguard_hybrid_dns_research_zero_cost_readiness_checkpoint", "label": "Zero-Cost Readiness Checkpoint", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-04-phase-3-wireguard-hybrid-dns-research.md", "source_location": "## Executive finding", "source_url": null, "captured_at": null, "author": null, "cont