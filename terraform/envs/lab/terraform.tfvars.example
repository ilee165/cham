# Copy to terraform.tfvars (gitignored) and fill in.
subscription_id    = "00000000-0000-0000-0000-000000000000"
home_ip            = "203.0.113.10/32"          # your home public IP
ssh_public_key     = "ssh-ed25519 AAAA... you@laptop"
wg_peer_public_key = "laptop-wireguard-public-key"
alert_email        = "you@example.com"
budget_start_date  = "2026-08-01T00:00:00Z"
vm_size                 = "Standard_D2als_v7" # hub appliance (NVMe-boot-only SKU)
test_vm_size            = "Standard_F1als_v7" # one-vCPU temporary VMs keep the paired topology within four regional cores
enable_private_resolver = false # keep disabled throughout Phase 2
enable_test_vm_app      = false # set per spoke to match the intended/live state
enable_test_vm_mgmt     = false # enable only for an approved, timeboxed verification window
enable_test_nic_app     = false # normally follows the VM; set explicitly for partial state
enable_test_nic_mgmt    = false # true + VM false preserves a quota-blocked NIC
